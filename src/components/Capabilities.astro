---
import type { Lang } from '../data/site';
import { capabilities, levelLabel, levelNote, sectionTitles } from '../data/content';
import Section from './Section.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Tingkat ditandai lewat warna & titik, bukan bilah persentase.
const dot: Record<string, string> = {
  core: 'bg-oxide',
  working: 'bg-blueprint',
  learning: 'bg-transparent border border-faint',
};
---

<Section id="capabilities" num="03" title={sectionTitles.capabilities[lang]} note={levelNote[lang]}>
  <div class="reveal grid gap-px border border-rule bg-rule sm:grid-cols-2">
    {
      capabilities.map((group) => (
        <div class="bg-panel p-5">
          <h3 class="label border-b border-rule-soft pb-3">{group.group[lang]}</h3>
          <ul class="mt-3 space-y-2">
            {group.items.map((item) => (
              <li class="flex items-center gap-3">
                <span class={`size-1.5 shrink-0 rounded-full ${dot[item.level]}`} aria-hidden="true" />
                <span class="text-sm">{item.name}</span>
                <span class="ml-auto font-mono text-[0.625rem] tracking-widest text-faint uppercase">
                  {levelLabel[item.level][lang]}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
