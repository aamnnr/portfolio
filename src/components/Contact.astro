---
import { site, type Lang } from '../data/site';
import { contact, sectionTitles, ui } from '../data/content';
import Section from './Section.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const rows = [
  { label: ui.email[lang], value: site.email, href: `mailto:${site.email}` },
  { label: ui.phone[lang], value: site.phone, href: `tel:${site.phoneHref}` },
  { label: ui.whatsapp[lang], value: site.phone, href: `https://wa.me/${site.whatsapp}` },
];
---

<Section id="contact" num="07" title={sectionTitles.contact[lang]} sticky={false}>
  <div class="reveal">
    <p class="max-w-2xl text-lg leading-relaxed text-pretty">{contact.body[lang]}</p>

    <a
      href={`mailto:${site.email}`}
      class="link-underline mt-8 inline-block text-[clamp(1.5rem,4vw,2.5rem)] leading-tight font-semibold tracking-tight text-oxide break-all"
    >
      {site.email}
    </a>

    <p class="label mt-3">{contact.note[lang]}</p>

    <!-- Dua pembaca, dua pintu masuk, satu alamat yang sama -->
    <dl class="mt-10 grid gap-px border border-rule bg-rule sm:grid-cols-2">
      {
        contact.paths.map((path) => (
          <div class="bg-panel p-5">
            <dt class="label">{path.who[lang]}</dt>
            <dd class="mt-1.5 text-sm leading-relaxed text-muted">{path.line[lang]}</dd>
          </div>
        ))
      }
    </dl>

    <!-- Isi pesan yang mempercepat balasan -->
    <div class="mt-6 border border-rule p-5">
      <p class="label">{contact.briefTitle[lang]}</p>
      <ol class="mt-3 grid gap-x-8 gap-y-2 sm:grid-cols-2">
        {
          contact.brief[lang].map((entry, i) => (
            <li class="flex gap-3 text-sm leading-relaxed">
              <span class="mt-0.5 font-mono text-xs text-faint tabular-nums">{String(i + 1).padStart(2, '0')}</span>
              <span>{entry}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <dl class="mt-10 grid gap-px border border-rule bg-rule sm:grid-cols-3">
      {
        rows.map((row) => (
          <div class="bg-panel p-4">
            <dt class="label">{row.label}</dt>
            <dd class="mt-1">
              <a href={row.href} rel="noopener noreferrer" class="link-underline font-mono text-sm break-all">
                {row.value}
              </a>
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-6 flex flex-wrap items-baseline gap-x-6 gap-y-2">
      <span class="label">{ui.elsewhere[lang]}</span>
      {
        site.socials.map((social) => (
          <a
            href={social.url}
            rel="noopener noreferrer"
            target="_blank"
            class="link-underline font-mono text-sm text-muted hover:text-ink"
          >
            {social.label} <span class="text-faint">{social.handle}</span>
          </a>
        ))
      }
    </div>
  </div>
</Section>
