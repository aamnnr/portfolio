---
import type { Lang } from '../data/site';
import { certifications, education, sectionTitles } from '../data/content';
import Section from './Section.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Section id="credentials" num="06" title={sectionTitles.credentials[lang]}>
  <div class="reveal border border-rule bg-panel p-5">
    <p class="label tabular-nums">{education.period[lang]}</p>
    <h3 class="mt-1.5 text-lg font-semibold tracking-tight">{education.degree[lang]}</h3>
    <p class="text-sm text-blueprint">{education.institution}</p>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">{education.note[lang]}</p>
  </div>

  <ul class="reveal mt-6 grid gap-px border border-rule bg-rule sm:grid-cols-2">
    {
      certifications.map((cert) => (
        <li class="bg-panel p-5">
          <p class="label">{lang === 'en' ? 'Certification' : 'Sertifikasi'}</p>
          <p class="mt-1.5 font-medium">{cert.title[lang]}</p>
          <p class="mt-0.5 font-mono text-xs text-muted">{cert.issuer}</p>
        </li>
      ))
    }
  </ul>
</Section>
