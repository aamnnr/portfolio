---
import { site, type Lang } from '../data/site';
import { nav, ui } from '../data/content';
import { localePath, otherLang } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** Tujuan tombol bahasa — halaman padanan, bukan selalu beranda. */
  switchHref?: string;
}
const { lang, switchHref } = Astro.props;
const other = otherLang(lang);
const home = localePath(lang);
// Anchor ditulis absolut supaya menu tetap berfungsi dari halaman detail proyek.
const anchor = (id: string) => `${home}#${id}`;
---

<header
  class="fixed top-0 right-0 left-0 z-40 border-b border-rule bg-paper/85 backdrop-blur-[2px] supports-[backdrop-filter]:bg-paper/70"
>
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-4 px-gutter">
    <!-- Blok identitas: kepala dokumen, bukan logo -->
    <a href={localePath(lang)} class="group flex min-w-0 shrink-0 items-baseline gap-2">
      <span class="font-mono text-sm font-medium tracking-tight">{site.name}</span>
      <span class="label hidden truncate sm:inline">{site.roleShort[lang]}</span>
    </a>

    <nav aria-label={ui.menu[lang]} class="ml-auto hidden lg:block">
      <ul class="flex items-center gap-5">
        {
          nav.map((item) => (
            <li>
              <a
                href={anchor(item.id)}
                data-nav-link={item.id}
                aria-current="false"
                class="group flex items-baseline gap-1.5 py-1 text-sm text-muted transition-colors hover:text-ink aria-[current=true]:text-ink"
              >
                <span class="font-mono text-[0.625rem] text-faint group-aria-[current=true]:text-oxide">
                  {item.num}
                </span>
                {item.label[lang]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1 lg:ml-0 lg:border-l lg:border-rule lg:pl-4">
      <a
        href={switchHref ?? localePath(other)}
        hreflang={other}
        lang={other}
        title={ui.langSwitch[lang]}
        class="px-2 py-1 font-mono text-xs tracking-widest text-muted uppercase transition-colors hover:text-oxide"
      >
        {other}
      </a>

      <button
        type="button"
        data-theme-toggle
        aria-pressed="false"
        aria-label={ui.theme[lang]}
        title={ui.theme[lang]}
        class="grid size-8 place-items-center text-muted transition-colors hover:text-oxide"
      >
        <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5"></circle>
          <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"
          ></path>
        </svg>
      </button>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={ui.menu[lang]}
        class="grid size-8 place-items-center text-muted transition-colors hover:text-oxide lg:hidden"
      >
        <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M3.5 7h17M3.5 12h17M3.5 17h17"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Panel navigasi mobile -->
  <div id="mobile-menu" data-menu-panel hidden class="border-t border-rule bg-panel lg:hidden">
    <ul class="mx-auto max-w-6xl divide-y divide-rule-soft px-gutter">
      {
        nav.map((item) => (
          <li>
            <a href={anchor(item.id)} class="flex items-baseline gap-3 py-3 text-base">
              <span class="font-mono text-xs text-oxide">{item.num}</span>
              {item.label[lang]}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>
