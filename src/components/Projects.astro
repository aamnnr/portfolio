---
import type { Lang } from '../data/site';
import { sectionTitles, ui } from '../data/content';
import { categories, projects, projectIndex } from '../data/projects';
import { projectPath } from '../i18n/utils';
import Section from './Section.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const note = {
  en: 'Each entry reads as a short spec: what goes in, what happens in the middle, what comes out. Open one for the full sheet.',
  id: 'Tiap entri dibaca sebagai spesifikasi singkat: apa yang masuk, apa yang terjadi di tengah, apa yang keluar. Buka salah satunya untuk lembar lengkapnya.',
}[lang];

// Hanya kategori yang benar-benar terpakai yang muncul sebagai tombol saring.
const used = categories.filter((c) => projects.some((p) => p.categories.includes(c.key)));
const countOf = (key: string) => projects.filter((p) => p.categories.includes(key as never)).length;
---

<Section id="projects" num="04" title={sectionTitles.projects[lang]} note={note}>
  <!-- Penyaring kategori. Tanpa JS semua entri tetap tampil. -->
  <div class="reveal" data-filter-root>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 border-b border-rule pb-4">
      <span class="label mr-1">{ui.filterLabel[lang]}</span>
      <div role="group" aria-label={ui.filterLabel[lang]} class="flex flex-wrap gap-x-1 gap-y-1">
        <button
          type="button"
          data-filter="all"
          aria-pressed="true"
          class="border border-rule px-2.5 py-1 font-mono text-xs transition-colors hover:border-ink aria-[pressed=true]:border-ink aria-[pressed=true]:bg-ink aria-[pressed=true]:text-paper"
        >
          {ui.filterAll[lang]}
          <span class="ml-1 text-[0.625rem] opacity-60">{projects.length}</span>
        </button>
        {
          used.map((cat) => (
            <button
              type="button"
              data-filter={cat.key}
              aria-pressed="false"
              title={cat.blurb[lang]}
              class="border border-rule px-2.5 py-1 font-mono text-xs transition-colors hover:border-ink aria-[pressed=true]:border-ink aria-[pressed=true]:bg-ink aria-[pressed=true]:text-paper"
            >
              {cat.label[lang]}
              <span class="ml-1 text-[0.625rem] opacity-60">{countOf(cat.key)}</span>
            </button>
          ))
        }
      </div>
      <p class="label ml-auto tabular-nums" data-filter-count aria-live="polite">
        {ui.showing[lang]} {projects.length} {ui.of[lang]} {projects.length}
      </p>
    </div>

    <ol class="divide-y divide-rule border-b border-rule">
      {
        projects.map((project) => (
          <li
            class="reveal py-8"
            data-project
            data-categories={project.categories.join(' ')}
          >
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <span class="font-mono text-xs text-oxide">{projectIndex(project.slug)}</span>
              <span class="label">
                {project.categories.map((c) => categories.find((x) => x.key === c)!.code).join(' · ')}
              </span>
              {project.codename && <span class="label hidden sm:inline">{project.codename}</span>}
              <span class="label ml-auto tabular-nums">{project.year}</span>
            </div>

            <h3 class="mt-2 text-xl font-semibold tracking-tight text-balance">
              <a href={projectPath(project.slug, lang)} class="link-underline">
                {project.title[lang]}
              </a>
            </h3>

            <p class="mt-3 max-w-2xl text-muted text-pretty">{project.summary[lang]}</p>

            <dl class="mt-5 grid gap-px border border-rule bg-rule md:grid-cols-3">
              {project.spec.map((row) => (
                <div class="bg-panel p-4">
                  <dt class="label">{row.k[lang]}</dt>
                  <dd class="mt-1.5 text-sm leading-relaxed">{row.v[lang]}</dd>
                </div>
              ))}
            </dl>

            <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
              <span class="label">{ui.stack[lang]}</span>
              <ul class="flex flex-wrap gap-x-3 gap-y-1 font-mono text-xs text-muted">
                {project.stack.map((tech) => (
                  <li class="before:mr-3 before:text-faint before:content-['/'] first:before:content-none">{tech}</li>
                ))}
              </ul>

              <a
                href={projectPath(project.slug, lang)}
                class="link-underline ml-auto font-mono text-xs text-oxide"
                aria-label={`${ui.readEntry[lang]}: ${project.title[lang]}`}
              >
                {ui.readEntry[lang]} &rarr;
              </a>
            </div>
          </li>
        ))
      }
    </ol>

    <!-- Muncul hanya jika sebuah saringan menyisakan nol entri. -->
    <p hidden data-filter-empty class="py-8 text-sm text-muted">
      {lang === 'en' ? 'No entries in this field yet.' : 'Belum ada entri di bidang ini.'}
    </p>
  </div>
</Section>
