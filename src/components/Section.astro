---
interface Props {
  id: string;
  num: string;
  title: string;
  note?: string;
  /** Kolom pertama menempel ke atas saat digulir (khas dokumen berlembar). */
  sticky?: boolean;
}
const { id, num, title, note, sticky = true } = Astro.props;
---

<section id={id} class="border-t border-rule scroll-mt-14">
  <div class="mx-auto max-w-6xl px-gutter">
    <div class="grid gap-8 py-16 md:grid-cols-[14rem_1fr] md:gap-12 md:py-24">
      <!-- Kolom kiri: penomoran & judul, seperti kepala bab pada dokumen teknis -->
      <div class={sticky ? 'md:sticky md:top-24 md:self-start' : ''}>
        <div class="flex items-baseline gap-3">
          <span class="font-mono text-xs text-oxide">{num}</span>
          <span class="h-px flex-1 bg-rule md:hidden"></span>
        </div>
        <h2 class="mt-2 text-2xl leading-tight font-semibold tracking-tight text-balance">{title}</h2>
        {note && <p class="mt-3 max-w-xs text-sm text-muted">{note}</p>}
      </div>

      <div class="min-w-0">
        <slot />
      </div>
    </div>
  </div>
</section>
