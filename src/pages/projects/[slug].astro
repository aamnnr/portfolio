---
import Base from '../../layouts/Base.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import { projects } from '../../data/projects';
import { site } from '../../data/site';
import { projectPath, absolute } from '../../i18n/utils';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;

const ld = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title.en,
  alternateName: project.codename,
  description: project.summary.en,
  dateCreated: project.year,
  keywords: project.stack.join(', '),
  author: { '@type': 'Person', name: site.name },
  url: absolute(projectPath(project.slug, 'en'), Astro.site),
  ...(project.repo ? { codeRepository: project.repo } : {}),
};
---

<Base
  lang="en"
  title={`${project.title.en} — ${site.name}`}
  description={project.summary.en}
  pathEn={projectPath(project.slug, 'en')}
  pathId={projectPath(project.slug, 'id')}
  extraLd={ld}
>
  <ProjectDetail lang="en" project={project} />
</Base>
